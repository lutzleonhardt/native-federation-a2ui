{
  "name": "conference-finder",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "playwright install chromium && npm --prefix agent install",
    "ng": "ng",
    "start": "concurrently -n shell,charts,maps,agent -c cyan,green,yellow,magenta --kill-others-on-fail \"npm run start:shell\" \"npm run start:charts\" \"npm run start:maps\" \"npm --prefix agent run start\"",
    "start:shell": "ng serve shell --port 4200",
    "start:charts": "ng serve mfe-charts --port 4201",
    "start:maps": "ng serve mfe-maps --port 4202",
    "start:agent": "npm --prefix agent run dev",
    "build": "ng build shell",
    "clean": "rm -rf dist .angular/cache node_modules/.cache/native-federation",
    "test": "npm run test:shell && npm run test:charts && npm run test:maps && npm run test:agent && npm run test:eval",
    "test:shell": "ng test shell",
    "test:charts": "ng test mfe-charts",
    "test:maps": "ng test mfe-maps",
    "test:agent": "npm --prefix agent test",
    "test:eval": "tsc -p eval/tsconfig.json && vitest run --config eval/vitest.config.ts",
    "lint": "ng lint && npm run lint:boundaries",
    "lint:boundaries": "sheriff verify",
    "eval": "tsx eval/run-eval.ts"
  },
  "dependencies": {
    "@a2ui/angular": "~0.10.5",
    "@a2ui/markdown-it": "~0.1.1",
    "@a2ui/web_core": "~0.10.6",
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@angular/cdk": "~21.2.14",
    "@angular/common": "~21.2.22",
    "@angular/compiler": "~21.2.22",
    "@angular/core": "~21.2.22",
    "@angular/forms": "~21.2.22",
    "@angular/platform-browser": "~21.2.22",
    "@angular/router": "~21.2.22",
    "@copilotkit/angular": "~0.3.1",
    "es-module-shims": "^2.8.0",
    "rxjs": "7.8.1",
    "tslib": "^2.3.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "~3.25.2"
  },
  "devDependencies": {
    "@angular-architects/native-federation-v4": "~21.2.11",
    "@angular-devkit/build-angular": "21.2.22",
    "@angular/build": "~21.2.22",
    "@angular/cli": "~21.2.22",
    "@angular/compiler-cli": "~21.2.22",
    "@eslint/js": "^10.0.1",
    "@softarc/native-federation-orchestrator": "^4.6.0",
    "@softarc/sheriff-core": "^0.19.6",
    "@types/node": "^22.20.2",
    "@vitest/browser": "~4.1.11",
    "@vitest/browser-playwright": "~4.1.11",
    "angular-eslint": "21.4.0",
    "concurrently": "~10.0.5",
    "eslint": "^10.3.0",
    "playwright": "^1.58.0",
    "prettier": "^3.8.1",
    "supports-color": "^7.2.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "~4.1.11"
  }
}
