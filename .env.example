# Provider selection for the agent server (agent/src/config.ts).
# One of: anthropic | openai | deepseek. Defaults to anthropic.
AGENT_PROVIDER=anthropic

# Optional: override the model id of the selected provider.
# AGENT_MODEL=claude-sonnet-5

# Only the key of the selected provider is required; resolveModel fails
# at startup naming the missing variable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
